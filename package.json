{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "assets:optimize": "node scripts/prepare-portfolio-images.mjs",
    "test:portfolio": "node --experimental-strip-types --test tests/sanctions-matcher.test.mjs tests/portfolio-ui.test.mjs",
    "test:portfolio-build": "node --test tests/portfolio-build.test.mjs",
    "analysis:build": "node analysis/scripts/build-hyperscaler-metrics.mjs && node analysis/scripts/build-eu-sanctions-data.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:guitar": "node --experimental-strip-types --test tests/guitar-music.test.mjs",
    "test:guitar-build": "node --test tests/guitar-build.test.mjs",
    "test:guitar-ui": "node --experimental-strip-types --test tests/guitar-ui.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "sass": "^1.97.3",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16"
  }
}
